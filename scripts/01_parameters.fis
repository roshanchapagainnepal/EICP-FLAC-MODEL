;===========================================================
; 01_parameters.fis
; Gai & Sanchez (2019), Acta Geotechnica 14:709-726
; Elastoplastic model for MICP / EICP cemented sand
;
; Global material constants and accumulators.
; Must be called BEFORE 02_m_eicp.fis.
;
; All globals use a leading $ so that PRINT fish stays clean
; (FISH Reference 2.8.8, hint 2). List them with PRINT $fish.
;
; UNITS: Pa throughout. Stress is TENSION POSITIVE in FLAC,
; but p and q inside the model are COMPRESSION POSITIVE.
;===========================================================
;
def eicp_par
;
; --- host sand parameters (Gai & Sanchez 2019, Table 1) ---
    $kappa_p  = 0.003        ; slope of swelling line, e-ln(p')
    $lambda_p = 0.25         ; slope of normal compression line
    $m_cs     = 1.09         ; slope of critical state line, M
;   Ds: dimensionless dilation parameter (Table 1, G&S 2019)
;   - multiplies deviatoric plastic strain only, not scaled
;   by p_c in Eq. 10 Version B
    $ds_p     = 0.04         ; dilation parameter, Ds
    $nu_p     = 0.17         ; Poisson's ratio
    $eta_p    = 60.0         ; sub-loading rate parameter, eta
;
; --- MICP / EICP parameters (Table 2) ---
;   NOTE: Eq. 3 is pb = a * chi * mc, and m_mc must be given
;   in PERCENT, not as a fraction. With a = 200 kPa, a calcite
;   content of mc = 2.4 gives pb = 480 kPa, which matches the
;   magnitudes plotted in paper Figure 12b. Entering mc as a
;   fraction (0.024) gives pb = 4.8 kPa and the cementation
;   would have no practical effect on the response.
    $a_pa     = 200000.0     ; bonding scaling constant a  (200 kPa)
;   mu SENSITIVITY STUDY (paper Figs. 13 and 14), run at
;   mc = 2.4 % and sigma3 = 100 kPa. Trials: 1.5, 4.5, 8.5, 12.5.
;   The published calibration value is 6.5 (Table 2) - restore it
;   after the study.
;   NOTE: paper Table 5 lists the fourth case as mu = 16.5, but
;   Figs. 13 and 14 are plotted for mu = 12.5. Use 12.5 to match
;   the plotted figures and report the inconsistency.
    $mu_p     = 1.5          ; mu TRIAL 1 (calibrated value 6.5)
;
; --- default initial state ---
    $ini_e    = 0.73         ; void ratio
    $ini_pc   = 150000.0     ; pre-consolidation pressure (Pa)
;                              NOTE: $ini_pc is only a FALLBACK,
;                              used by case 1 / case 3 if a zone
;                              has no m_pc set. It is NOT the
;                              value the tests run with - see
;                              $ini_pc0 below.
    $ini_r    = 0.01         ; sub-loading ratio R
    $ini_chi  = 1.0          ; damage factor chi (1 = intact bonding)
;
; --- CALIBRATED pre-consolidation pressure ---
;   pc is an initial state variable, not a measured parameter,
;   and the paper does not report it. It was calibrated against
;   the UNTREATED curve of Fig. 10a (sigma3 = 200 kPa): trials
;   at 900 kPa gave a 460 kPa peak, 800 kPa gave 420 kPa at 5%
;   strain, matching the 410-420 kPa target. See the pc
;   Sensitivity Study section of docs/IMPLEMENTATION_NOTES.md.
;
;   This ONE value carries forward to every mc case unchanged,
;   which is the paper's "reference soil" methodology. Do not
;   re-tune it per calcite content.
    $ini_pc0  = 800000.0     ; CALIBRATED (Pa)
;
; --- numerical guards ---
    $p_min    = 1.0          ; floor on mean effective stress (Pa)
    $pc_min   = 100.0        ; floor on pre-consolidation pressure (Pa)
    $chi_min  = 1.0e-6       ; floor on damage factor
    $r_min    = 1.0e-6       ; floor on sub-loading ratio
    $r_max    = 1.0          ; ceiling on sub-loading ratio
    $kb_dflt  = 1.0e9        ; default bulk modulus bound (Pa)
;
; --- subzone accumulators (reset every zsub cycle) ---
;   All are volume weighted: each subzone contribution is
;   multiplied by zart*zxbar, and $m_wt_acc accumulates the
;   weights so the zone average is a true volume average.
    $m_wt_acc   = 0.0        ; accumulated subzone volume
    $m_vol_acc  = 0.0        ; total volumetric strain
    $m_depv_acc = 0.0        ; plastic volumetric strain
    $m_depq_acc = 0.0        ; plastic deviatoric strain
    $m_dept_acc = 0.0        ; plastic strain norm
    $m_p_acc    = 0.0        ; mean effective stress
    $m_q_acc    = 0.0        ; deviatoric stress
    $m_pls_acc  = 0.0        ; plasticity flag
;
end
;
eicp_par
;
; --- switch: set to 0.0 to drop the Ds shear-hardening term ---
; --- and recover the classical MCC hardening law.           ---
def eicp_mcc
    $ds_p  = 0.0
    $eta_p = 0.0
end
;
;===========================================================
; EOF
;===========================================================
