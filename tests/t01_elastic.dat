; ==========================================================
; t01_elastic.dat
; TEST 1 - nonlinear elastic response only.
;
; PURPOSE: verify the elastic predictor and the stress
; dependent bulk modulus K = (1+e) p' / kappa in isolation.
;
; SETUP: pre-consolidation pressure is set enormously high
; so the yield surface is never reached. No cementation.
;
; EXPECTED RESULT: on the swelling line the model must give
;     e = e0 - kappa * ln(p'/p0)
; so a plot of t_e against t_lnp must be a STRAIGHT LINE of
; slope -kappa = -0.003. This is the acceptance criterion.
; ==========================================================
;
config axi
grid 1 1
title
Test 1 - nonlinear elastic isotropic compression
;
; --- model ---
call ..\scripts\01_parameters.fis
call ..\scripts\02_m_eicp.fis
model m_eicp
;
; --- properties: pc huge, no cementation, R = 1 ---
prop dens 1700.0
prop m_e 0.73  m_pc 1.0e12  m_chi 1.0  m_r 1.0  m_mc 0.0
prop m_kb 1.0e10
;
; --- initial stress state: isotropic 100 kPa ---
ini sxx -100000.0 syy -100000.0 szz -100000.0
;
; --- seed the stress dependent moduli ---
ini_eicp
;
; --- boundary conditions: isotropic compression ---
fix x
fix y
ini xvel -1.0e-7 i=2
ini yvel -1.0e-7 j=2
;
; --- monitored quantities ---
def path
    t_p   = -(sxx(1,1) + syy(1,1) + szz(1,1)) / 3.0
    t_lnp = ln(t_p)
    t_e   = m_e(1,1)
    t_ind = m_ind(1,1)
    t_k   = m_e1(1,1) - 2.0 * m_g2(1,1) / 3.0
end
;
his nstep 20
his unbal
his path
his t_p
his t_lnp
his t_e
his t_ind
his t_k
;
step 10000
;
; --- results ---
; History slots: 1 unbal, 2 path, 3 t_p, 4 t_lnp, 5 t_e,
;                6 t_ind, 7 t_k
;
; History 5 (t_e) versus history 4 (t_lnp) must be a straight
; line of slope -0.003. History 6 (t_ind) must stay at 0.0
; for the whole run, confirming no plasticity occurred.
;
plot his 5 vs 4 hold
plot his 7 vs 4 hold
plot his 6 hold
;
print m_e m_pc m_r m_chi m_ind
;
save t01_elastic.sav
;
return
