; ==========================================================
; t06_lab.dat
; LABORATORY VALIDATION SERIES - own test programme
;
; PURPOSE. Validate the implemented Gai & Sanchez (2019) EICP
; model against this project's own consolidated drained
; triaxial tests. pc is the SOLE fitted parameter, calibrated
; against the untreated specimen US-100 only; every treated
; run is therefore a prediction, not a fit.
;
; This is NOT the Gai verification series (t03) nor the
; Kennedy 2023 external validation (t05). Both are unchanged.
; The constitutive model 02_m_eicp.fis is also unchanged - it
; is frozen after verification, and only the parameter file
; and this driver are new.
;
; PHASE A - untreated calibration
;   US-100: sigma3 = 100 kPa, e0 = 0.740 measured, mc = 0
;   Calibrate $ini_pc_lab in 01d_params_lab.fis against this
;   specimen alone. Judge BOTH peak magnitude AND
;   strain-to-peak.
;
; PHASE B - treated prediction
;   Set t_mc to the measured calcite content. Change NOTHING
;   else. a = 200 kPa and mu = 6.5 stay at their published
;   values; they are the quantities under test.
;
; M = 1.09 RETAINED, NOT CALIBRATED. Both specimens were still
; softening at the 20 % termination strain (dq/d(eps_a) =
; -3.47 and -1.29 kPa/%), so end-of-test eta is an UPPER BOUND
; on M, not a measurement. Binding constraint M <= 1.147, and
; the published 1.09 is consistent with it. See the header of
; 01d_params_lab.fis.
; ==========================================================
;
config axi
grid 1 1
title
t06 - laboratory validation, CD triaxial
;
; --- model ---
; NOTE: calls the LAB parameter file. Do not also call
; 01_parameters.fis or 01c_params_kennedy.fis in this session.
call ..\scripts\01d_params_lab.fis
call ..\scripts\02_m_eicp.fis
model m_eicp
;
;-----------------------------------------------------------
; CASE DEFINITION
;
; set_case is defined BEFORE the SET lines because the FLAC
; SET command can only assign to a FISH symbol that already
; exists. Defining it afterwards gives "Bad keyword ... t_mc".
;
; SINGLE SOURCE FOR sigma3. t_sig3 drives BOTH the initial
; stresses AND the servo target, by assigning them directly.
; In an earlier driver the confining pressure was encoded in
; two independent places and changing only one produced a run
; that looked stable while silently servo-ing to the wrong
; pressure. There is no second place to forget here.
;-----------------------------------------------------------
;
def set_case
;   --- per-zone state ---
    m_mc(1,1) = t_mc
    m_e(1,1)  = t_e0
    m_pc(1,1) = $ini_pc_lab
;   --- initial isotropic stress state (tension positive) ---
    sxx(1,1)  = -t_sig3
    syy(1,1)  = -t_sig3
    szz(1,1)  = -t_sig3
    sxy(1,1)  = 0.0
;   --- servo target, driven from the SAME variable ---
    $s_target = -t_sig3
end
;
; --- CASE SELECTION: edit these three values ---
set t_sig3=200000.0   ; confining pressure, Pa
set t_mc=0.0          ; calcite content in PERCENT (0 = untreated)
set t_e0=0.740        ; measured void ratio, specimen US-100
;
; --- properties ---
; m_pc is NOT set here - set_case assigns it from $ini_pc_lab
; in 01d_params_lab.fis, so the pc calibration is driven from
; a single line in that file.
prop dens 1700.0
prop m_chi 1.0  m_kb 1.0e10
;
set_case
;
; --- consistent sub-loading initialisation ---
; computes R0 from the initial stress state, pc and pb
ini_eicp_r
;
; --- CHECK THIS: 1.0 means pc is too small for sigma3 ---
; Expected for Phase A trial 1: R0 = 100000/460000 = 0.2174
print $eicp_err
print m_r m_pb m_pc m_e1
;
;-----------------------------------------------------------
; BOUNDARY CONDITIONS - fully velocity controlled
;
; Every gridpoint is fixed in both directions, so there are
; ZERO free degrees of freedom and the radial boundary cannot
; oscillate. The radial stress is held by the servo below.
; A stress-controlled boundary on a single zone sitting on the
; symmetry axis diverges; this configuration does not.
;-----------------------------------------------------------
fix x
fix y
;
; Axial loading rate. 1.0e-7 x 2 000 000 steps = 0.20 m on a
; 1 m specimen = 20 % axial strain, matching the laboratory
; termination strain exactly.
ini yvel -1.0e-7 j=2
ini xvel 0.0 i=2
;
;-----------------------------------------------------------
; RADIAL STRESS SERVO
;
; Holds sxx at t_sig3 by adjusting the radial gridpoint
; velocity each step, instead of applying a force to a free
; boundary. $s_target is set by set_case, NOT here, so that
; sigma3 has exactly one source.
;
; GAIN. Over one step the radial strain increment produced by
; a velocity vx is approximately vx (zone width 1 m, dt = 1 in
; FLAC static mode), so d(sxx) = m_e1 * vx and a deadbeat gain
; would be 1/m_e1. A deadbeat servo chatters in an explicit
; code, so $s_gain is held at 5.0e-10 - the same value used
; throughout the verified Gai series and the Kennedy series.
;
; K = (1+e)p'/kappa scales with p', so the effective loop gain
; scales with sigma3:
;   sigma3 =  50 kPa  ->  ~0.03 of deadbeat (very safe)
;   sigma3 = 100 kPa  ->  ~0.06 of deadbeat
;   sigma3 = 200 kPa  ->  ~0.12 of deadbeat (as designed)
;   sigma3 = 400 kPa  ->  ~0.24 of deadbeat (still stable)
; Under-gaining only costs tracking accuracy; over-gaining
; oscillates. If t_sr ever oscillates around the target rather
; than tracking it smoothly, reduce $s_gain and change nothing
; else.
;-----------------------------------------------------------
;
def servo_set
    $s_gain = 5.0e-10      ; ~0.06 of deadbeat at 100 kPa
    $s_vmax = 1.0e-6       ; runaway clamp on radial velocity
end
servo_set
;
def servo
    while_stepping
    $s_err = sxx(1,1) - $s_target
    $s_vx  = -$s_gain * $s_err
    if $s_vx > $s_vmax then
        $s_vx = $s_vmax
    end_if
    if $s_vx < -$s_vmax then
        $s_vx = -$s_vmax
    end_if
    xvel(2,1) = $s_vx
    xvel(2,2) = $s_vx
end
;
; --- monitored quantities ---
def path
    t_sa  = -syy(1,1)                    ; axial stress
    t_sr  = -sxx(1,1)                    ; radial stress, servo check
    t_q   = t_sa - t_sr                  ; deviatoric stress
    t_p   = -(sxx(1,1) + syy(1,1) + szz(1,1)) / 3.0
    t_eta = t_q / t_p                    ; stress ratio, -> M at CS
    t_ea  = -ydisp(1,2) * 100.0          ; axial strain, per cent
    t_e   = m_e(1,1)
;
;   Volumetric strain, per cent, COMPRESSION POSITIVE (lab
;   convention). Exact for constant solid volume:
;   ev = -de/(1+e0). m_e is already volume weighted over the
;   subzones by the UDM, using zart*zxbar rather than zsub,
;   which matters in axisymmetry where subzone volumes differ.
    t_ev  = -(t_e - t_e0) / (1.0 + t_e0) * 100.0
;
;   NOT cross-checked with FLAC's vsi: vsi is a PER-STEP
;   increment, not an accumulated total, despite Example 2.31
;   using it as one. t_ev was verified geometrically instead -
;   at 20 % strain r = 1.135, h = 0.800 give V = 3.2376 against
;   V0 = 3.1416, i.e. ev = -3.06 % against t_ev = -3.10 %.
;
    t_pc  = m_pc(1,1)
    t_pb  = m_pb(1,1)
    t_chi = m_chi(1,1)
    t_r   = m_r(1,1)
    t_hrd = m_r(1,1) * (m_pc(1,1) + m_pb(1,1))    ; R(pc + pb)
end
;
his nstep 20
his unbal
his path
his t_ea
his t_q
his t_p
his t_ev
his t_e
his t_pc
his t_pb
his t_chi
his t_r
his t_hrd
his t_eta
his t_sr
;
; --- large-strain mode ---
; FLAC samples mode 3 (cm_max) only at the start of stepping in
; small-strain mode, so the timestep would be sized against the
; initial stiffness. K = (1+e)p'/kappa grows as p' rises during
; shearing. Large-strain mode re-calls mode 3 every ten steps so
; the timestep tracks the stiffening, and it is the appropriate
; mode at 20 % axial strain.
set large
;
step 2000000
;
; --- results ---
; History slots: 1 unbal, 2 path, 3 t_ea, 4 t_q, 5 t_p,
;                6 t_ev, 7 t_e, 8 t_pc, 9 t_pb, 10 t_chi,
;                11 t_r, 12 t_hrd, 13 t_eta, 14 t_sr
;
; stress-strain: q versus axial strain
plot his 4 vs 3 hold
; volumetric strain versus axial strain (compression positive)
plot his 6 vs 3 hold
; stress path in p'-q space
plot his 4 vs 5 hold
; stress ratio: approaches M = 1.09 only at critical state
plot his 13 vs 3 hold
; cementation state: damage factor and sub-loading ratio
plot his 10 11 vs 3 hold
; hardening: pc, pb and the effective hardening parameter
plot his 8 9 12 vs 3 hold
; servo check: radial stress must hold flat at t_sig3
plot his 14 vs 3 hold
;
print m_e m_pc m_pb m_chi m_r m_ind m_epv m_epq
;
save t06_lab.sav
;
return
